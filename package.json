{
  "name": "financ-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Financ: app (PWA) do assistente financeiro pessoal",
  "scripts": {
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "build:server": "node server/build.mjs",
    "build": "npm run build:web && npm run build:server",
    "start": "node dist/server.mjs",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.8",
    "@simplewebauthn/server": "14.0.3",
    "fastify": "5.12.7",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@fontsource-variable/hanken-grotesk": "5.3.0",
    "@simplewebauthn/browser": "14.0.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "workbox-window": "7.4.1"
  }
}
